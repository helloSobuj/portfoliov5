# Supabase project credentials (Project Settings -> API in the Supabase dashboard).
# The anon/publishable key is safe to expose in client code; row-level security
# policies (see supabase/schema.sql) are what actually protect the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Google Maps embed URL for the Contact page map. Leave unset to
# hide the map and show contact details only.
VITE_CONTACT_MAP_EMBED_URL=
